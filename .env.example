# Sao chép file này thành ".env" (hoặc export trực tiếp trong shell) và
# điền API key của bạn. KHÔNG commit file ".env" thật lên GitHub.

# Dùng cho provider="gemini" (mặc định) — lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dùng nếu đổi sang provider="anthropic" — lấy tại console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dùng nếu đổi sang provider="openai" — lấy tại platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
